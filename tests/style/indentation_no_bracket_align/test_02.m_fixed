function test_02()
    % Nested brackets: ] should align with [ line, not statement start
    tf = ismember( ...
        obj, ...
        [ ...
            foo, ...
            bar ...
        ] ...
    );

    % Nested round brackets inside matrix
    x = [ ...
        func( ...
            arg1, ...
            arg2 ...
        ), ...
        func( ...
            arg3 ...
        ) ...
    ];

    % Triple nesting
    y = foo( ...
        bar( ...
            [ ...
                1, ...
                2 ...
            ] ...
        ) ...
    );

    % Nested brackets with wrong indentation on closing brackets
    z = foo( ...
        [ ...
            1, ...
            2 ...
        ] ...
    );

    % Nested with inner closing bracket too deep
    w = foo( ...
        [ ...
            1, ...
            2 ...
        ] ...
    );
end
